  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "// Mira si ese día y hora ya están en la hoja y deja la fecha escrita en castellano para el correo.\nconst w = $('Cita desde la web').first().json.body;\nconst cogido = $('Leer citas').all().some(i => String(i.json.fecha || '').trim() === w.fecha && String(i.json.hora || '').trim() === w.hora);\nconst fecha_larga = DateTime.fromISO(w.fecha).setLocale('es').toFormat(\"cccc d 'de' LLLL\");\nreturn [{ json: { libre: !cogido, fecha_larga } }];"
   },
   "name": "¿Hueco libre?",
